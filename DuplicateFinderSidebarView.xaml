<UserControl x:Class="DuplicateFinder.DuplicateFinderSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DuplicateFinder"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition   Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="10"
                    Grid.Row="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
            <CheckBox   Name="IncludeHiddenGamesCheckBox"
                        d:Content="Include hidden games"
                        Content="{DynamicResource LOCDuplicateFinder_IncludeHidden}"
                        IsChecked="{Binding IncludeHiddenGames}"
                        Margin="0,0,0,10"/>
            <CheckBox   Name="InstalledOnlyCheckBox"
                        d:Content="Only installed games"
                        Content="{DynamicResource LOCDuplicateFinder_InstalledOnly}"
                        IsChecked="{Binding InstalledOnly}"
                        Margin="0,0,0,10"/>
            <CheckBox   Name="CheckSimilarityCheckBox"
                        d:Content="Check for similarity"
                        Content="{DynamicResource LOCDuplicateFinder_CheckSimilar}"
                        IsChecked="{Binding CheckSimilarity}"
                        Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal">
                <Label  d:Content="Tolerance"
                        Content="{DynamicResource LOCDuplicateFinder_Tolerance}"
                        VerticalAlignment="Center"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="{DynamicResource LOCDuplicateFinder_ToleranceTooltip}"/>
                <Slider Name="ToleranceSlider"
                        VerticalAlignment="Center"
                        Minimum="0"
                        Maximum="10"
                        Value="{Binding Tolerance}"
                        Width="200"
                        IsEnabled="{Binding IsChecked, ElementName=CheckSimilarityCheckBox}"
                        ToolTipService.ShowDuration="30000"
                        ToolTip="{DynamicResource LOCDuplicateFinder_ToleranceTooltip}"
                        Margin="10,0,0,0"/>
                <Label  Content="{Binding ElementName=ToleranceSlider, Path=Value}"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0" />
            </StackPanel>
            <Button Name="FindButton"
                    d:Content="Find duplicates"
                    Content="{DynamicResource LOCDuplicateFinder_FindButton}"
                    Click="OnFindButtonClicked"
                    Width="150"
                    HorizontalAlignment="Left"
                    Margin="0,10,0,0"/>
            <Label  d:Content="Filter results:"
                    Content="{DynamicResource LOCDuplicateFinder_FilterLabel}"
                    Margin="0,10,0,0"/>
            <TextBox  Name="FilterTextBox"
                      Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,2,0,0"/>
            <CheckBox Name="GroupResultsCheckBox"
                      d:Content="Group matches together"
                      Content="{DynamicResource LOCDuplicateFinder_GroupResults}"
                      IsChecked="{Binding GroupResults}"
                      Margin="0,10,0,0"/>
        </StackPanel>
        <Separator  Grid.Row="1"/>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="10,0,10,8"
                    HorizontalAlignment="Left">
            <TextBlock    d:Text="(Ctrl/Shift-click to select multiple rows)"
                          Text="{DynamicResource LOCDuplicateFinder_MultiSelectHint}"
                          Foreground="{DynamicResource TextBrushDarker}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
            <Button   Name="HideSelectedButton"
                      d:Content="Hide selected"
                      Content="{DynamicResource LOCDuplicateFinder_HideSelected}"
                      Click="OnHideSelectedClicked"
                      Margin="0,0,5,0"/>
            <Button   Name="UnhideSelectedButton"
                      d:Content="Unhide selected"
                      Content="{DynamicResource LOCDuplicateFinder_UnhideSelected}"
                      Click="OnUnhideSelectedClicked"
                      Margin="0,0,5,0"/>
            <Button   Name="RemoveSelectedButton"
                      d:Content="Remove selected"
                      Content="{DynamicResource LOCDuplicateFinder_RemoveSelected}"
                      Click="OnRemoveSelectedClicked"/>
        </StackPanel>
        <ListView   Name="ResultsList"
                    ItemsSource="{Binding FoundDuplicates}"
                    Grid.Row="3"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    GridViewColumnHeader.Click="OnColumnHeaderClicked"
                    ContextMenuOpening="OnResultsContextMenuOpening"
                    MouseDoubleClick="OnResultsDoubleClick"
                    SelectionMode="Extended"
                    Margin="10,10,10,0">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_ShowInLibrary}"
                              d:Header="Show in library"
                              InputGestureText="Double-click"
                              Click="OnShowInLibraryClicked" />
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_EditGame}"
                              d:Header="Edit game..."
                              Click="OnEditGameClicked" />
                    <Separator />
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_HideGame}"
                              d:Header="Hide game"
                              Click="OnHideClicked" />
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_UnhideGame}"
                              d:Header="Unhide game"
                              Click="OnUnhideClicked" />
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_KeepOneHideRest}"
                              d:Header="Keep this one, hide the rest"
                              Click="OnKeepOneHideRestClicked" />
                    <Separator />
                    <MenuItem Header="{DynamicResource LOCDuplicateFinder_DeleteButton}"
                              d:Header="Remove"
                              Click="OnRemoveFromContextMenuClicked" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <TextBlock    FontWeight="Bold"
                                                          Foreground="{DynamicResource TextBrush}"
                                                          Margin="0,6,0,2"
                                                          Text="{Binding Name}"/>
                                            <ItemsPresenter />
                                        </StackPanel>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image  Source="{Binding IconImage, IsAsync=True}"
                                        Width="32"
                                        Height="32" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="NameColumn"
                                    d:Header="Name"
                                    Header="{DynamicResource LOCNameLabel}"
                                    DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn x:Name="LibraryColumn"
                                    d:Header="Library"
                                    Header="{DynamicResource LOCLibrary}"
                                    DisplayMemberBinding="{Binding Library}" />
                    <GridViewColumn x:Name="PlatformsColumn"
                                    Header="{DynamicResource LOCDuplicateFinder_PlatformsHeader}"
                                    d:Header="Platforms"
                                    DisplayMemberBinding="{Binding Platforms}" />
                    <GridViewColumn x:Name="SourceColumn"
                                    Header="{DynamicResource LOCDuplicateFinder_SourceHeader}"
                                    d:Header="Source"
                                    DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn x:Name="PlaytimeColumn"
                                    Header="{DynamicResource LOCDuplicateFinder_PlaytimeHeader}"
                                    d:Header="Playtime (h)"
                                    DisplayMemberBinding="{Binding PlaytimeDisplay}" />
                    <GridViewColumn x:Name="LastPlayedColumn"
                                    Header="{DynamicResource LOCDuplicateFinder_LastPlayedHeader}"
                                    d:Header="Last played"
                                    DisplayMemberBinding="{Binding LastPlayedDisplay}" />
                    <GridViewColumn x:Name="InstallDirectoryColumn"
                                    Header="{DynamicResource LOCDuplicateFinder_InstallDirectoryHeader}"
                                    d:Header="Install location"
                                    DisplayMemberBinding="{Binding InstallDirectoryDisplay}" />
                    <GridViewColumn x:Name="InstalledColumn"
                                    d:Header="Installed"
                                    Header="{DynamicResource LOCDuplicateFinder_InstalledHeader}"
                                    DisplayMemberBinding="{Binding InstalledDisplay}" />
                    <GridViewColumn x:Name="HiddenColumn"
                                    d:Header="Hidden"
                                    Header="{DynamicResource LOCDuplicateFinder_HiddenHeader}"
                                    Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Checked/unchecked writes straight to the database -->
                                <CheckBox   IsChecked="{Binding IsHidden, UpdateSourceTrigger=PropertyChanged}"
                                            Checked="OnHiddenToggled"
                                            Unchecked="OnHiddenToggled"
                                            HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn d:Header="Remove"
                                    Header="{DynamicResource LOCDuplicateFinder_DeleteButtonHeader}"
                                    Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource LOCDuplicateFinder_DeleteButton}"
                                        d:Content="Remove"
                                        Click="OnDeleteButtonClicked"
                                        HorizontalAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
